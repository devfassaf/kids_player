<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android TV (v1.0.9): leanback declared OPTIONAL so ONE APK serves tablet + TV;
         touchscreen optional so TV devices (no touch) accept the install. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- allowBackup=false: Auto Backup can't restore a sideloaded app anyway (adb install /
         tapped APK never restores), and false blocks adb-backup extraction of the PIN hash.
         The full-state export in the parent screen is the real backup mechanism. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Free rotation (user request 2026-07-29, replacing the earlier sensorLandscape
             lock): the app now supports portrait AND landscape; configChanges includes
             orientation so the WebView handles rotation without an activity restart. -->
        <!-- v1.0.76: supportsPictureInPicture — HOME can shrink a playing video into a
             floating window (opt-in per profile, pushed from JS; onUserLeaveHint decides).
             configChanges above already carries smallestScreenSize|screenLayout, which is
             what lets the PiP resize happen without recreating the activity mid-video. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- v1.0.9: appear in the Android TV launcher too -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- F12b: share a video from the YouTube app straight into the library -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- v1.0.63 — the app's FIRST service. It exists only so Android will keep the
             family's OWN audio/video playing when the app goes to the background, and it
             runs only while a parent has turned that setting on for a profile. It is not
             exported: nothing outside the app may start it. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Permissions: FIVE DECLARED HERE since v1.0.63, and the three new ones all belong
         to ONE opt-in feature (keep playing with the screen off). Before it there were
         exactly two, and that is still what a family who never enables the setting
         effectively uses. Still no WAKE_LOCK (F7 uses a window flag), no storage
         (app-scoped dirs only), no WRITE_SETTINGS, no READ_PHONE_STATE (v1.0.57 reads the
         audio MODE instead).

         ⚠️ THE SHIPPED APK SHOWS EIGHT, and that is not a mistake — measured on the real
         v1.0.63 build with `aapt2 dump badging`. Gradle merges library manifests in:
         USE_BIOMETRIC + USE_FINGERPRINT come from androidx.biometric (the v1.0.26 PIN
         recovery), and DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION is Capacitor's own. Count
         the APK, not this file, before telling anyone what the app asks for. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- F14: in-app updater launches the package installer on a downloaded APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v1.0.63: background playback. FOREGROUND_SERVICE_MEDIA_PLAYBACK is required from
         API 34; POST_NOTIFICATIONS is a RUNTIME prompt on API 33+, and if the parent
         denies it the service still runs — they just lose the visible control, which the
         setting's hint says out loud rather than degrading in silence. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
