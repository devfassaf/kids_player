{
  "name": "kids-player",
  "version": "1.0.75",
  "private": true,
  "type": "module",
  "description": "Child-safe curated YouTube + direct-video player for a 4-year-old (Android / Capacitor)",
  "scripts": {
    "serve": "node dev-server.mjs",
    "test": "node --test",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "android:build": "cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk ./gradlew assembleDebug",
    "apk": "cap copy android && cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk ./gradlew assembleDebug",
    "apk:release": "cap copy android && cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk ./gradlew assembleRelease",
    "apk:verify": "$HOME/Library/Android/sdk/build-tools/34.0.0/apksigner verify --print-certs -v android/app/build/outputs/apk/release/app-release.apk",
    "signing:report": "cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk ./gradlew :app:signingReport",
    "android:run": "cap run android",
    "release": "./release.sh",
    "release:win": "powershell -ExecutionPolicy Bypass -File release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
